{
    "version": 2,
    "functions": {
        "api/*.js": {
            "maxDuration": 10
        }
    },
    "crons": [
        {
            "path": "/api/cron",
            "schedule": "0 11 * * *"
        }
    ],
    "headers": [
        {
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ],
            "source": "/(.*)"
        }
    ]
}